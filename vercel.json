{
  "redirects": [
    {
      "source": "/pricing",
      "destination": "/system",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?zenryokuesthe\\.com"
        }
      ],
      "destination": "https://enka-salon.jp/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?zenryokuesthe\\.com"
        }
      ],
      "destination": "https://enka-salon.jp/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/interview",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/marketing-study",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/invite",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "x-site-brand",
          "value": "enka"
        }
      ],
      "headers": [
        {
          "key": "x-enka-original-path",
          "value": ":path*"
        }
      ]
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?enka-salon\\.jp"
        }
      ],
      "headers": [
        {
          "key": "x-enka-original-path",
          "value": ":path*"
        }
      ]
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-site-brand",
          "value": "enka"
        }
      ],
      "headers": [
        {
          "key": "x-enka-original-path",
          "value": "__root__"
        }
      ]
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?enka-salon\\.jp"
        }
      ],
      "headers": [
        {
          "key": "x-enka-original-path",
          "value": "__root__"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/automations/o2-store-availability",
      "destination": "/api/automations/estama?action=o2-store-availability"
    },
    {
      "source": "/api/cron/o2-store-availability",
      "destination": "/api/cron/estama-availability?action=o2-store-availability"
    },
    {
      "source": "/marketing-study",
      "destination": "/marketing-study.html"
    },
    {
      "source": "/api/cast-posts/delete",
      "destination": "/api/automations/admin-portal-post?action=delete-failed-post"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-site-brand",
          "value": "enka"
        }
      ],
      "destination": "/api/spa?path=__root__"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "x-site-brand",
          "value": "enka"
        }
      ],
      "destination": "/api/spa?path=:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?enka-salon\\.jp"
        }
      ],
      "destination": "/api/spa?path=__root__"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?enka-salon\\.jp"
        }
      ],
      "destination": "/api/spa?path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
